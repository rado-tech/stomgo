{
  "name": "stomgo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "bot": "tsx scripts/bot.ts",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "backup": "tsx --env-file=.env scripts/backup.ts",
    "backup:daemon": "tsx --env-file=.env scripts/backup.ts --daemon",
    "maplibre:worker": "node scripts/copy-maplibre-worker.mjs",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "postinstall": "node scripts/copy-maplibre-worker.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "node --import tsx --test tests/*.e2e.ts",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@sentry/nextjs": "^10.70.0",
    "bcryptjs": "^3.0.3",
    "grammy": "^1.45.1",
    "jose": "^6.2.9",
    "maplibre-gl": "^6.4.1",
    "next": "16.3.1",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
