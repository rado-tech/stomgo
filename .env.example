# StomGo — muhit o'zgaruvchilari namunasi
# Nusxa oling:  cp .env.example .env   va qiymatlarni to'ldiring.
# .env fayli hech qachon git'ga tushmaydi.

# ============ MAJBURIY ============

# Postgres ulanishi
DATABASE_URL="postgresql://stomgo:PAROL@localhost:5433/stomgo?schema=public"

# Docker Compose uchun baza paroli (DATABASE_URL dagi bilan bir xil bo'lsin)
DB_PASSWORD="uzun-tasodifiy-parol"

# Sessiya imzosi. Serverda ALBATTA yangi tasodifiy qiymat qo'ying:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="uzun-tasodifiy-satr-kamida-32-belgi"


# ============ TELEGRAM (kirish kodi shu orqali keladi) ============
# @BotFather dan olinadi. Bo'sh bo'lsa kod ekranda ko'rsatiladi (faqat sinov uchun).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""


# ============ PUSH BILDIRISHNOMA ============

# Sayt/PWA uchun Web Push kalitlari:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@stomgo.uz"
# Ochiq kalit klientga ham kerak — yuqoridagi VAPID_PUBLIC_KEY bilan bir xil
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Android ilova uchun Firebase Cloud Messaging.
# Firebase konsoli → Project settings → Service accounts → Generate new private key
# JSON faylni ./secrets/ ichiga qo'ying va yo'lni shu yerga yozing.
FCM_SERVICE_ACCOUNT="./secrets/firebase-service-account.json"


# ============ IXTIYORIY ============

# AI triaj (bo'sh bo'lsa qoidalar asosidagi tahlil ishlaydi)
GEMINI_API_KEY=""

# Xatolarni kuzatish
SENTRY_DSN=""
# Brauzer tomoni — server DSN bilan bir xil qiymat
NEXT_PUBLIC_SENTRY_DSN=""

# SMS ATAYLAB YO'Q: kirish faqat Telegram bot orqali.

# Yuklangan rasmlar papkasi (Docker'da /app/uploads)
UPLOADS_DIR=""

# Zaxira nusxa
BACKUP_DIR="./backups"
BACKUP_KEEP="14"

# OTP kodini javobda ochiq ko'rsatish — FAQAT lokal ishlab chiqish uchun.
# Ishlab chiqarishda (NODE_ENV=production) bu qiymat e'tiborga olinmaydi.
# Telegram bot ishlamayotgan paytda lokal sinov qilish uchun "1" qo'ying.
ALLOW_SCREEN_OTP=""

# Saytning ommaviy manzili — sitemap, Schema.org va ulashish havolalari uchun.
# Doimiy domen olingach shu yerga yoziladi, aks holda localhost ishlatiladi.
NEXT_PUBLIC_SITE_URL=""
